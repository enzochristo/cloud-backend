
model User {
  id               Int            @id @default(autoincrement())
  name             String
  email            String         @unique
  password         String
  balance          Decimal        @default(0)
  
  // Vertical Slice Relations
  loans            Loan[]
  transfersSent    Transfer[]     @relation("SentTransfers")
  transfersReceived Transfer[]    @relation("ReceivedTransfers")
}